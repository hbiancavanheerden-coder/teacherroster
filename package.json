    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.17",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
