# ---------- Frontend (public by design: Firebase web config is not a secret) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ---------- Server only (Netlify Functions). NEVER prefix these with VITE_ ----------
# Firebase Admin: from a service-account key (Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Resend (https://resend.com) - verified sending domain required
RESEND_API_KEY=
EMAIL_FROM="Staffboard <hello@yourdomain.co.za>"
CONTACT_TO=you@yourdomain.co.za

# PayFast (https://payfast.io) - Settings > Integration. A passphrase is REQUIRED for subscriptions.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# true = sandbox.payfast.co.za (use sandbox merchant credentials), false = live
PAYFAST_SANDBOX=true

# Anthropic (https://console.anthropic.com) - used to read uploaded rosters/timetables (PDF, Word, Excel, photos)
ANTHROPIC_API_KEY=

# Public URL of the site, used in emails and payment callbacks
APP_URL=http://localhost:8888
